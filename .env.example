# Copy to .env for local development. Use only the Supabase public URL and publishable key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: set this to a stable site origin when preview deployment callback URLs vary.
# VITE_AUTH_REDIRECT_URL=https://www.example.com
